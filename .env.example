# Copy to backend/.env and fill in. backend/.env is gitignored.

# ── AI provider — set ONE of these (Gemini is checked first) ──────────────
# Direct Google Gemini key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# OR route through OpenRouter (separate quota pool): https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-flash
OPENROUTER_FREE_MODEL=google/gemini-2.0-flash-exp:free
OPENROUTER_REFERER=http://localhost:5173
OPENROUTER_TITLE=Vyapar-Mitra

# ── Optional ─────────────────────────────────────────────────────────────
# Google Places for business discovery (falls back to OpenStreetMap Overpass if unset)
GOOGLE_MAPS_API_KEY=
