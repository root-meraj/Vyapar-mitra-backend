# Copy to backend/.env and fill in. backend/.env is gitignored.

# ── AI provider — REQUIRED for advisory / feasibility / chat ──────────────
# All LLM calls route through OpenRouter (https://openrouter.ai/keys).
OPENROUTER_API_KEY=

# Model ids use OpenRouter's naming.
OPENROUTER_MODEL=google/gemini-2.5-flash
# Free-tier fallback, used only when the primary model returns 429.
OPENROUTER_FREE_MODEL=google/gemini-2.0-flash-exp:free
# Shown in the OpenRouter dashboard only.
OPENROUTER_REFERER=http://localhost:5173
OPENROUTER_TITLE=Vyapar-Mitra

# ── Optional ─────────────────────────────────────────────────────────────
# Google Places for business discovery (falls back to OpenStreetMap Overpass if unset)
GOOGLE_MAPS_API_KEY=
